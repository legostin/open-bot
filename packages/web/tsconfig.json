{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@owlbot/shared": ["./src/shared-types.ts"],
      "@owlbot/shared/i18n": ["../shared/src/i18n.ts"],
      "@owlbot/shared/avatar": ["../shared/src/avatar.ts"],
      "@owlbot/shared/group": ["../shared/src/group.ts"],
      "@owlbot/shared/thinking": ["../shared/src/thinking.ts"],
      "@owlbot/ui": ["../ui-sdk/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
