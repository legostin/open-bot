{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owlbot",
  "mainBinaryName": "Owlbot",
  "version": "../../../package.json",
  "identifier": "ai.owlbot.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "../../../packaging/assets/png/32x32.png",
      "../../../packaging/assets/png/128x128.png",
      "../../../packaging/assets/png/128x128@2x.png",
      "../../../packaging/assets/png/icon.png",
      "../../../packaging/assets/owlbot.icns",
      "../../../packaging/assets/owlbot.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "dmg": {
        "background": "../../../packaging/assets/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["owlbot"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NTJCNDM2RjNDOTMyQzYKUldUR01zbnpOclJTSjQvaWhSbDRGOXdYZURoVU8rUWFUblhMQlM3RDY2TmVLa0p6emo5Umt4VVoK",
      "endpoints": ["https://github.com/legostin/open-bot/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
