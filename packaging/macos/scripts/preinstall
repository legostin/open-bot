#!/bin/sh
# Runs as root before the files are copied: stops the hub of the user at the console and removes the previous app code,
# so an upgrade never mixes old and new files. The data dir is in the user's home and stays.
USER_NAME="$(stat -f %Su /dev/console)"
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != root ]; then
  launchctl bootout "gui/$(id -u "$USER_NAME")/ai.openbot.hub" 2>/dev/null
fi
rm -rf "/Library/Application Support/open-bot/app" "/Library/Application Support/open-bot/bin" \
  "/Applications/open-bot/open-bot.app" "/Applications/open-bot/Uninstall open-bot.app"
exit 0
