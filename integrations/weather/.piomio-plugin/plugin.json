{
  "id": "weather",
  "name": "%name%",
  "version": "0.1.0",
  "author": "Piomio",
  "description": "%description%",
  "builtin": true,
  "defaultEnabled": false,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "contributes": {
    "tools": true,
    "widgets": ["forecast"],
    "settings": {
      "type": "object",
      "properties": {
        "units": { "type": "string", "title": "%settings.units.title%", "enum": ["metric", "imperial"], "default": "metric" }
      }
    }
  },
  "integration": {"category": "everyday", "icon": "cloud-sun", "connect": "none", "summary": "%integration.summary%", "example": "%integration.example%", "popular": 1},
  "permissions": {
    "network": ["api.open-meteo.com", "geocoding-api.open-meteo.com"]
  }
}
