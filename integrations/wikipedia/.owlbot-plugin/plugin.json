{
  "id": "wikipedia",
  "name": "%name%",
  "version": "0.1.0",
  "author": "Owlbot",
  "description": "%description%",
  "builtin": true,
  "defaultEnabled": false,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "contributes": {
    "tools": true,
    "widgets": ["article"]
  },
  "integration": {"category": "reading", "icon": "book-open", "connect": "none", "summary": "%integration.summary%", "example": "%integration.example%"},
  "permissions": {
    "network": ["*.wikipedia.org"]
  }
}
