{
  "id": "triggers",
  "name": "%name%",
  "version": "0.1.0",
  "description": "%description%",
  "builtin": true,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "toolPrefix": "trigger",
  "contributes": {
    "tools": true,
    "http": true,
    "triggers": ["schedule", "once", "watch", "event", "heartbeat"],
    "settings": {
      "type": "object",
      "properties": {
        "allowPrivateUrls": {
          "type": "boolean",
          "title": "%settings.allowPrivateUrls.title%",
          "description": "%settings.allowPrivateUrls.description%",
          "default": false
        },
        "watchTimeoutSec": {
          "type": "integer",
          "title": "%settings.watchTimeoutSec.title%",
          "default": 30,
          "minimum": 1,
          "maximum": 120
        }
      }
    }
  },
  "permissions": {
    "network": ["*"],
    "core": ["tasks.create", "tasks.list", "agents.list", "machines.list", "settings.get", "notify", "ui.emit"],
    "ui": ["route"]
  }
}
