{
  "id": "brain-codex",
  "name": "%name%",
  "version": "0.1.0",
  "description": "%description%",
  "builtin": true,
  "server": "./server/index.ts",
  "contributes": {
    "brains": ["codex"],
    "settings": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "title": "%settings.command.title%", "default": "codex" },
        "apiKeyRef": { "type": "string", "title": "%settings.apiKeyRef.title%", "description": "%settings.apiKeyRef.description%" },
        "sandbox": { "type": "string", "enum": ["danger-full-access", "workspace-write", "read-only"], "default": "danger-full-access", "title": "%settings.sandbox.title%", "description": "%settings.sandbox.description%" }
      }
    }
  },
  "permissions": { "vault": ["openai_api_key"] }
}
