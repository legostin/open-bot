{
  "id": "brain-api",
  "name": "%name%",
  "version": "0.1.0",
  "description": "%description%",
  "server": "./server/index.ts",
  "builtin": true,
  "contributes": {
    "setup": {
      "secrets": [
        {"vault": "anthropic_api_key", "title": "%setup.anthropic.title%", "hint": "%setup.anthropic.hint%", "link": "https://console.anthropic.com/settings/keys", "pattern": "^sk-ant-api\\d{2}-[A-Za-z0-9_-]{20,}$"},
        {"vault": "openai_api_key", "title": "%setup.openai.title%", "hint": "%setup.openai.hint%", "link": "https://platform.openai.com/api-keys", "pattern": "^sk-(?!ant-|or-)[A-Za-z0-9_-]{20,}$"},
        {"vault": "openrouter_api_key", "title": "%setup.openrouter.title%", "hint": "%setup.openrouter.hint%", "link": "https://openrouter.ai/settings/keys", "pattern": "^sk-or-v1-[A-Za-z0-9]{20,}$"},
        {"vault": "custom_llm_api_key", "setting": "customKeyRef", "title": "%setup.custom.title%", "hint": "%setup.custom.hint%"}
      ]
    },
    "brains": ["api"],
    "settings": {
      "type": "object",
      "properties": {
        "defaultVariant": {
          "type": "string",
          "title": "%settings.defaultVariant.title%",
          "description": "%settings.defaultVariant.description%",
          "enum": ["anthropic", "openai", "openrouter", "custom"],
          "default": "anthropic"
        },
        "anthropicModel": {
          "type": "string",
          "title": "%settings.anthropicModel.title%",
          "description": "%settings.anthropicModel.description%",
          "default": "claude-opus-5-5"
        },
        "openaiModel": { "type": "string", "title": "%settings.openaiModel.title%", "default": "gpt-5" },
        "openrouterModel": { "type": "string", "title": "%settings.openrouterModel.title%", "default": "openrouter/auto" },
        "customModel": { "type": "string", "title": "%settings.customModel.title%", "default": "llama3.1" },
        "maxTokens": { "type": "integer", "title": "%settings.maxTokens.title%", "minimum": 256, "default": 16000 },
        "maxSteps": { "type": "integer", "title": "%settings.maxSteps.title%", "minimum": 1, "default": 40 },
        "anthropicBaseUrl": { "type": "string", "title": "%settings.anthropicBaseUrl.title%", "default": "https://api.anthropic.com" },
        "openaiBaseUrl": { "type": "string", "title": "%settings.openaiBaseUrl.title%", "default": "https://api.openai.com/v1" },
        "openrouterBaseUrl": { "type": "string", "title": "%settings.openrouterBaseUrl.title%", "default": "https://openrouter.ai/api/v1" },
        "customBaseUrl": {
          "type": "string",
          "title": "%settings.customBaseUrl.title%",
          "description": "%settings.customBaseUrl.description%",
          "default": "http://127.0.0.1:11434/v1"
        },
        "customKeyRef": {
          "type": "string",
          "title": "%settings.customKeyRef.title%",
          "description": "%settings.customKeyRef.description%",
          "default": ""
        },
        "customVision": { "type": "boolean", "title": "%settings.customVision.title%", "default": false },
        "anthropicEffort": {
          "type": "string",
          "title": "%settings.anthropicEffort.title%",
          "description": "%settings.anthropicEffort.description%",
          "enum": ["", "low", "medium", "high", "xhigh", "max"],
          "default": ""
        },
        "anthropicRefusalFallback": {
          "type": "boolean",
          "title": "%settings.anthropicRefusalFallback.title%",
          "description": "%settings.anthropicRefusalFallback.description%",
          "default": true
        },
        "anthropicEagerToolStreaming": {
          "type": "boolean",
          "title": "%settings.anthropicEagerToolStreaming.title%",
          "description": "%settings.anthropicEagerToolStreaming.description%",
          "default": true
        },
        "historyTokenBudget": { "type": "integer", "title": "%settings.historyTokenBudget.title%", "minimum": 4000, "default": 150000 },
        "customHistoryTokenBudget": { "type": "integer", "title": "%settings.customHistoryTokenBudget.title%", "minimum": 2000, "default": 24000 },
        "maxToolResultChars": { "type": "integer", "title": "%settings.maxToolResultChars.title%", "minimum": 1000, "default": 200000 }
      }
    }
  },
  "permissions": {
    "network": ["api.anthropic.com", "api.openai.com", "openrouter.ai"],
    "vault": ["anthropic_api_key", "openai_api_key", "openrouter_api_key", "custom_llm_api_key"]
  }
}
