{
  "id": "browser",
  "name": "%name%",
  "version": "0.1.0",
  "description": "%description%",
  "builtin": true,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "contributes": {
    "tools": true,
    "http": true,
    "settings": {
      "type": "object",
      "properties": {
        "headless": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "title": "%settings.headless.title%",
          "description": "%settings.headless.description%"
        },
        "idleMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "title": "%settings.idleMinutes.title%"
        },
        "allowLocalNetwork": {
          "type": "boolean",
          "default": false,
          "title": "%settings.allowLocalNetwork.title%",
          "description": "%settings.allowLocalNetwork.description%"
        },
        "takeoverWaitSec": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "title": "%settings.takeoverWaitSec.title%",
          "description": "%settings.takeoverWaitSec.description%"
        },
        "maxDownloadMb": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "title": "%settings.maxDownloadMb.title%"
        },
        "searchEngine": {
          "type": "string",
          "enum": [
            "duckduckgo",
            "google",
            "yandex",
            "bing"
          ],
          "default": "duckduckgo",
          "title": "%settings.searchEngine.title%",
          "description": "%settings.searchEngine.description%"
        },
        "rememberActions": {
          "type": "boolean",
          "default": true,
          "title": "%settings.rememberActions.title%",
          "description": "%settings.rememberActions.description%"
        }
      }
    }
  },
  "integration": {"category": "work", "icon": "app-window", "connect": "none", "summary": "%integration.summary%", "example": "%integration.example%"},
  "permissions": {
    "network": [
      "*"
    ],
    "vault": [
      "login:*"
    ],
    "core": [
      "ui.emit",
      "files.deliver",
      "conversations.tell",
      "speech.transcribe",
      "files.fetch"
    ],
    "ui": [
      "live.view",
      "chat.toolResult"
    ]
  }
}
