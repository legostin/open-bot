{
  "id": "memory",
  "name": "%name%",
  "version": "0.1.0",
  "description": "%description%",
  "author": "open-bot",
  "builtin": true,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "contributes": {
    "tools": true,
    "hooks": ["session.start"],
    "http": true,
    "settings": {
      "type": "object",
      "properties": {
        "promptMaxChars": {
          "type": "integer",
          "title": "%settings.promptMaxChars.title%",
          "description": "%settings.promptMaxChars.description%",
          "default": 4000,
          "minimum": 500,
          "maximum": 20000
        },
        "git": {
          "type": "boolean",
          "title": "%settings.git.title%",
          "description": "%settings.git.description%",
          "default": true
        }
      }
    }
  },
  "permissions": {
    "core": ["ui.emit"],
    "ui": ["route"]
  }
}
