{
  "id": "memory",
  "name": "%name%",
  "version": "0.2.0",
  "description": "%description%",
  "author": "Piomio",
  "builtin": true,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "contributes": {
    "tools": true,
    "hooks": ["session.start", "turn.context"],
    "http": true,
    "settings": {
      "type": "object",
      "properties": {
        "promptMaxChars": {
          "type": "integer",
          "title": "%settings.promptMaxChars.title%",
          "description": "%settings.promptMaxChars.description%",
          "default": 4000,
          "minimum": 500,
          "maximum": 20000
        },
        "recallMaxChars": {
          "type": "integer",
          "title": "%settings.recallMaxChars.title%",
          "description": "%settings.recallMaxChars.description%",
          "default": 1500,
          "minimum": 300,
          "maximum": 8000
        },
        "reflect": {
          "type": "boolean",
          "title": "%settings.reflect.title%",
          "description": "%settings.reflect.description%",
          "default": true
        },
        "git": {
          "type": "boolean",
          "title": "%settings.git.title%",
          "description": "%settings.git.description%",
          "default": true
        }
      }
    }
  },
  "integration": {"category": "assistant", "icon": "notebook-pen", "connect": "none", "summary": "%integration.summary%", "example": "%integration.example%"},
  "permissions": {
    "core": ["ui.emit", "tasks.create"],
    "ui": ["route"]
  }
}
