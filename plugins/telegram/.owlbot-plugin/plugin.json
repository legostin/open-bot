{
  "id": "telegram",
  "name": "%name%",
  "version": "0.1.0",
  "description": "%description%",
  "builtin": true,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "contributes": {
    "setup": {
      "secrets": [
        {"vault": "telegram_bot_token", "setting": "botTokenRef", "title": "%setup.botToken.title%", "hint": "%setup.botToken.hint%", "link": "https://t.me/BotFather", "pattern": "^\\d{6,12}:[A-Za-z0-9_-]{30,}$", "required": true}
      ]
    },
    "channels": ["telegram"],
    "http": true,
    "settings": {
      "type": "object",
      "properties": {
        "botTokenRef": {
          "type": "string",
          "title": "%settings.botTokenRef.title%",
          "description": "%settings.botTokenRef.description%",
          "default": "vault://telegram_bot_token"
        },
        "apiBaseUrl": {
          "type": "string",
          "title": "%settings.apiBaseUrl.title%",
          "description": "%settings.apiBaseUrl.description%",
          "default": "https://api.telegram.org"
        },
        "pollTimeoutSec": {
          "type": "integer",
          "title": "%settings.pollTimeoutSec.title%",
          "default": 30,
          "minimum": 1,
          "maximum": 50
        },
        "tokenRetrySec": {
          "type": "integer",
          "title": "%settings.tokenRetrySec.title%",
          "default": 60,
          "minimum": 1
        }
      }
    }
  },
  "permissions": {
    "network": ["api.telegram.org"],
    "vault": ["telegram_bot_token"],
    "core": ["channels.inbound", "approvals.resolve", "notifications.feedback", "tasks.list", "settings.get", "ui.emit"],
    "ui": ["settings.section"]
  }
}
