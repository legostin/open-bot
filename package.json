{
  "name": "owlbot",
  "version": "0.1.0",
  "private": true,
  "description": "Friendly, proactive, self-hosted personal agent. Your subscriptions, your machines, secure by default.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning packages/core/src/cli.ts start",
    "start": "node --disable-warning=ExperimentalWarning packages/core/src/cli.ts start",
    "build": "npm run build:ui-plugins && npm run build:node && npm run build -w @owlbot/pages-kit && npm run build -w @owlbot/web && npm run build -w @owlbot/console",
    "build:ui-plugins": "node scripts/build-ui-plugins.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/pages-kit/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:node": "node scripts/build-node-bundle.mjs",
    "build:tailnet": "node scripts/build-tailnet.mjs",
    "package:desktop": "node packaging/desktop/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
