# The hub (owlbot) starts brain CLIs as "agent" and other plugins / MCP servers as "plugin".
# env_reset drops the hub's environment; the hub names every variable a child gets with --preserve-env
# (SETENV), so secrets travel in the environment and never on a command line other users could read.
Defaults:owlbot !requiretty, !lecture, env_reset
owlbot ALL=(agent,plugin) NOPASSWD:SETENV: ALL
